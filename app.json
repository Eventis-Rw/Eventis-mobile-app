{
  "expo": {
    "name": "Eventis",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nzizaprince5.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.nzizaprince5.mobile"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Eventis to share your camera during in-app video calls and Live broadcasts.",
          "microphonePermission": "Allow Eventis to share your voice during in-app calls and Live broadcasts."
        }
      ],
      "expo-font",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Eventis to save and update people in your phone contacts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Eventis to attach photos to your messages.",
          "cameraPermission": "Allow Eventis to take photos for your messages and of your ID when you verify your age.",
          "microphonePermission": "Allow Eventis to use your microphone for voice messages, in-app calls, and Live rooms."
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Eventis uses your location to show events near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_splach-mobile.jpeg",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/logo_splach-mobile.jpeg"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Eventis to use your microphone for voice messages and Live rooms."
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Eventis to preview your camera before going live.",
          "microphonePermission": "Allow Eventis to share your voice during in-app calls and Live broadcasts.",
          "recordAudioAndroid": true
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2e35084e-8666-4033-b8ad-f6f2e1a567e9"
      }
    },
    "owner": "muben"
  }
}
