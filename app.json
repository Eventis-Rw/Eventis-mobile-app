{
  "expo": {
    "name": "Eventis",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
"image": "./assets/images/logo-primary.png",
"imageWidth": 130,
"resizeMode": "contain",
"backgroundColor": "#FFFFFF",
"dark": {
  "backgroundColor": "#000000",
  "image": "./assets/images/logo-primary.png"
}
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
