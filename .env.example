# Set this to an address reachable from your device when testing API-backed features.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Load events from the API instead of the built-in mock data.
# EXPO_PUBLIC_USE_EVENTS_API=true

# Call the organiser subscription/organisation endpoints instead of the local demo.
# The backend org and payments modules are not implemented yet.
# EXPO_PUBLIC_USE_ORGANISER_API=true

# Call the profile/settings endpoints (notification preferences, discovery preferences,
# saved organisers, reviews, business verification) instead of the local demo.
# The backend identity/notification modules are not implemented yet; switch off any
# feature in PROFILE_FEATURES (services/profileService.ts) whose endpoint hasn't shipped.
# EXPO_PUBLIC_USE_PROFILE_API=true

# Turn on FindLove (tab, /love screens and their data). Off by default; while off the
# app makes no FindLove network calls and every FindLove link redirects home.
# EXPO_PUBLIC_FINDLOVE_ENABLED=true

# Important: enabling the FindLove tab alone still uses demo profiles. Set this
# separately to load profiles, age verification, connections, chats and notices
# from the backend. Keep false only when intentionally using the local demo.
# Call the FindLove age verification, profile, discovery, connection, chat, and
# notification endpoints instead of local demo data. The API must be reachable
# at EXPO_PUBLIC_API_URL, and the signed-in user needs verified age and an active
# FindLove membership on the backend.
# EXPO_PUBLIC_USE_FINDLOVE_API=true

# Shared Live directory; use the same API host on both testers' phones.
# EXPO_PUBLIC_LIVE_API_URL=http://192.168.1.10:3000

# LiveKit public project URL; participant tokens come from the Eventis backend.
# Keep LIVEKIT_API_KEY and LIVEKIT_API_SECRET exclusively on the backend.
# EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Charge for Live coins with MTN MoMo / Airtel Money through the API instead of the test top-up.
# The backend payments module is not implemented yet.
# EXPO_PUBLIC_USE_LIVE_PAYMENTS_API=true

# Send Live reports to the API instead of keeping them on the device.
# The backend moderation module is not implemented yet.
# EXPO_PUBLIC_USE_LIVE_REPORTS_API=true

# Native Google sign-in: OAuth client IDs from the same Google Cloud project.
# Use a Web application client ID here, including when running on Android.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Required for Google sign-in on iOS; app.config.js derives the reversed URL scheme.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# See docs/authentication.md for API credentials, migration, and native rebuild steps.
